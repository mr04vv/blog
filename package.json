{
  "name": "basic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler pages dev",
    "deploy": "$npm_execpath run build && wrangler pages deploy",
    "check": "biome check ./app",
    "check:fix": "biome check --write ./app",
    "check:fix:unsafe": "biome check --write --unsafe ./app",
    "lint:text": "textlint \"**/*.mdx\" -f pretty-error",
    "lint:text:fix": "textlint --fix \"**/*.mdx\"",
    "typecheck": "tsc --noEmit",
    "create": "bun createEntry.ts",
    "convert": "bun convertImages.ts"
  },
  "private": true,
  "dependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/postcss": "4.3.3",
    "@hono/react-renderer": "1.0.1",
    "@hono/vite-ssg": "0.3.3",
    "@mdx-js/rollup": "3.1.1",
    "@resvg/resvg-js": "2.6.2",
    "budoux": "0.8.4",
    "framer-motion": "12.43.0",
    "hono": "4.13.0",
    "honox": "0.1.60",
    "jsdom": "30.0.1",
    "lodash": "4.18.1",
    "motion": "12.43.0",
    "rehype-highlight": "7.0.2",
    "rehype-pretty-code": "0.14.5",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "satori": "0.29.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "@hono/vite-cloudflare-pages": "0.4.3",
    "@hono/vite-dev-server": "0.26.1",
    "@textlint/textlint-plugin-markdown": "15.8.0",
    "@types/bun": "1.3.14",
    "@types/jsdom": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/prompts": "2.4.9",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "prompts": "2.4.2",
    "tailwindcss": "4.3.3",
    "textlint": "15.8.0",
    "textlint-filter-rule-allowlist": "4.0.0",
    "textlint-rule-ja-space-between-half-and-full-width": "3.0.2",
    "textlint-rule-preset-ja-spacing": "3.0.2",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "vite": "8.2.1",
    "vite-plugin-static-copy": "4.1.1",
    "wrangler": "4.119.0"
  }
}
